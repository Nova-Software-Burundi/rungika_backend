APP_NAME="Rungika"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rungika.nova.bi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rungika
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.nova.bi
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@rungika.nova.bi"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# App Custom (centralized config)
APP_TAGLINE="Send & Receive Money Across Africa"
APP_LOGO=images/logo.png
SUPPORT_EMAIL=info@rungika.com
SUPPORT_PHONE=+250 79 123 456
PHYSICAL_ADDRESS="Kigali, Rwanda"
AUTO_EMAIL_DOMAIN=rungika.app
DEFAULT_SEND_CURRENCY=USD
DEFAULT_PAYOUT_CURRENCY=ZMW
OTP_EXPIRY_MINUTES=10
OTP_LOCK_MINUTES=5
TWOSTEP_TEMP_TOKEN_MINUTES=5
TWOSTEP_SETUP_TOKEN_MINUTES=10
OTP_BYPASS_TOKEN=
FLAG_CDN_URL=https://flagcdn.com/w80

# Support SLA (minutes)
SLA_LOW_FIRST_RESPONSE=480
SLA_LOW_RESOLUTION=2880
SLA_NORMAL_FIRST_RESPONSE=240
SLA_NORMAL_RESOLUTION=1440
SLA_HIGH_FIRST_RESPONSE=60
SLA_HIGH_RESOLUTION=480
SLA_URGENT_FIRST_RESPONSE=15
SLA_URGENT_RESOLUTION=120

WIALON_API_URL=https://hst-api.wialon.com/wialon/ajax.html
WIALON_API_TOKEN=your_generated_token_here
WIALON_API_TOKEN_FLEET2=second_fleet_token_here
SDK_URL=https://hosting.wialon.eu/login.html

# Twilio for WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
#Twilio WhatsApp sender
TWILIO_WHATSAPP_FROM=whatsapp:+1415XXXXXXX

# Firebase (server-side verification)
FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# General
VITE_API_BASE_URL=/api
SANCTUM_STATEFUL_DOMAINS=rungika.nova.bi,localhost,127.0.0.1,::1,localhost:5173,127.0.0.1:5173

# CORS
CORS_ALLOWED_ORIGINS=https://rungika.nova.bi,http://localhost:5173,https://localhost:5173

# Fines
FINES_API_URL=
FINES_TIN=
FINES_REFERER=
FINES_RPK=
FINES_NEWRELIC=
FINES_NLS=English

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=your_id
PUSHER_APP_KEY=your_key
PUSHER_APP_SECRET=your_secret
PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_APP_KEY=xxxxxxxxxxxxxx
VITE_PUSHER_APP_CLUSTER=mt1
